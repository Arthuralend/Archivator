{
  "name": "archivator",
  "productName": "Archivator",
  "version": "1.0.0",
  "description": "Архиватор для macOS (Apple Silicon) в стиле WinRAR: ZIP, 7Z, RAR",
  "main": "electron/main.cjs",
  "author": "Archivator",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "fetch-7z": "node scripts/fetch-7zz.mjs",
    "dist": "npm run fetch-7z && vite build && electron-builder --mac --arm64 -c.directories.output=release"
  },
  "build": {
    "appId": "com.archivator.app",
    "productName": "Archivator",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "fileAssociations": [
        {
          "ext": "zip",
          "name": "ZIP Archive",
          "role": "Viewer"
        },
        {
          "ext": "rar",
          "name": "RAR Archive",
          "role": "Viewer"
        },
        {
          "ext": "7z",
          "name": "7-Zip Archive",
          "role": "Viewer"
        }
      ]
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
